(session "specctra_rounded_board"
  (base_design "specctra_rounded_board")
  (placement
    (resolution um 10)
    (component konnect_image_R1
      (place R1 1000000 -500000 front 0)
    )
    (component konnect_image_R2
      (place R2 1100000 -500000 front 0)
    )
  )
  (was_is
  )
  (routes 
    (resolution um 10)
    (parser
      (host_cad "KiCad's Pcbnew")
      (host_version "10.0.5")
    )
    (library_out 
      (padstack "konnect_via_0001"
        (shape
          (circle F.Cu 6000 0 0)
        )
        (shape
          (circle B.Cu 6000 0 0)
        )
        (attach off)
      )
    )
    (network_out 
      (net VCC
        (wire
          (path F.Cu 2000
            1105000 -505517
            1104455 -506062
            995545 -506062
            995000 -505517
          )
        )
        (wire
          (path F.Cu 2000
            1105000 -500000
            1105000 -505517
          )
        )
        (wire
          (path F.Cu 2000
            995000 -500000
            995000 -505517
          )
        )
      )
      (net GND
        (wire
          (path F.Cu 2000
            1050000 -500000
            1095000 -500000
          )
        )
      )
    )
  )
)